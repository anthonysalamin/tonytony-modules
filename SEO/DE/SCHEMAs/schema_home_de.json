      "mainEntity": [
        {
          "@type": "Question",
          "name": "Warum TONYTONY wählen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "TONYTONY ist Anthony Salamin — Senior Webdesigner & Creative Developer mit über 15 Jahren Erfahrung. In der Schweiz geboren, geprägt von der Berliner Startup-Szene, heute als fokussiertes One-Man-Studio im Wallis tätig. Zusammenarbeit mit Teams auf der ganzen Welt 🌍"
          }
        },
        {
          "@type": "Question",
          "name": "Ist eine mehrsprachige Website möglich?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Absolut — Webflow unterstützt mehrsprachige Websites nativ. Französisch, Deutsch, Englisch, 日本語, 中文 — keine Grenzen. Sie behalten die volle Kontrolle über Ihre Inhalte und Übersetzungen im CMS."
          }
        },
        {
          "@type": "Question",
          "name": "Bieten Sie Support an?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Immer — Schulung zur eigenständigen Verwaltung Ihrer Website, technischer Support und laufende Wartung. Ich begleite Sie auch lange nach dem Launch."
          }
        },
        {
          "@type": "Question",
          "name": "Arbeiten Sie auch mit Kunden außerhalb der Schweiz?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja. Ich bin in der Schweiz ansässig, arbeite aber weltweit — remote-first, sofern die Zeitzonen es zulassen."
          }
        }
